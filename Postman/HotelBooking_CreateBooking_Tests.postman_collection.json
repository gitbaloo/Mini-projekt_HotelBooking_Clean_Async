									"    jsonData.forEach(function(booking) {",
									"        pm.expect(booking).to.have.property('startDate');",
									"        pm.expect(booking).to.have.property('endDate');",
									"        pm.expect(booking).to.have.property('customerId');",
									"        pm.expect(booking).to.have.property('roomId');",
