				{
					"name": "Verify Rooms Exist",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response is JSON', function () {",
									"    pm.response.to.be.json;",
									"});",
									"",
									"pm.test('At least 2 rooms exist (seeded by DbInitializer)', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.length).to.be.at.least(2);",
									"    // Store room count for later use",
									"    pm.collectionVariables.set('roomCount', jsonData.length);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
