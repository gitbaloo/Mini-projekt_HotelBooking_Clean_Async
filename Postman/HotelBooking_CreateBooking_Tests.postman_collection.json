				{
					"name": "TC1 - Valid booking (room available) returns 201",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var runOffsetDays = pm.collectionVariables.get('runOffsetDays');",
									"if (!runOffsetDays) {",
									"    runOffsetDays = 120 + Math.floor(Math.random() * 2000);",
									"    pm.collectionVariables.set('runOffsetDays', runOffsetDays);",
									"}",
									"",
									"var startDate = new Date();",
									"startDate.setDate(startDate.getDate() + Number(runOffsetDays));",
									"var endDate = new Date(startDate);",
									"endDate.setDate(endDate.getDate() + 5);",
									"",
									"pm.variables.set('startDate', startDate.toISOString().split('T')[0]);",
									"pm.variables.set('endDate', endDate.toISOString().split('T')[0]);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201 Created - booking successful', function () {",
									"    pm.response.to.have.status(201);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"startDate\": \"{{startDate}}\",\n  \"endDate\": \"{{endDate}}\",\n  \"customerId\": 1\n}"
						},
